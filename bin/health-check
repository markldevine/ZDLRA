#!/usr/bin/env raku

use JSON::Fast;
use Our::Cache;

#   dbmcli -n -m -e list alerthistory

use lib $*HOME ~ '/github.com/ZDLRA/lib';
use ZDLRA::ComputeNode::PhysicalDisk::Details;
use ZDLRA::StorageCell::PhysicalDisk::Details;
use lib '/home/mdevine/github.com/raku-Our-KV/lib';
use Our::KV;
use Data::Dump::Tree;

constant INVENTORY-CACHE-KEY    = 'ZDLRA_inventory';

my %ZDLRAS;

sub MAIN (
    Int   :$log-days                = 0,           #= log days to display (bypass "only unseen logs" mechanism)
    Int   :$refresh-inventory       = False,       #= clear inventory cache, consult KV store for site configuration
) {
    my @all-compute-nodes;
    my @all-storage-cells;
    my @cellcli-gateways;

    my $inventory-cache             = Our::Cache.new(:identifier(INVENTORY-CACHE-KEY), :subdirs($*PROGRAM-NAME.IO.basename, INVENTORY-CACHE-KEY));

    if $refresh-inventory || !$inventory-cache.cache-hit {
        my $kv-server               = Our::KV.new(:kv-cli('/usr/bin/redis-cli'), :local-port-forward);
        my @compute-node-keys       = $kv-server.KEYS(:key('eb:zdlra:*:computenodes'));
        die "No ZDLRA compute node keys!" unless @compute-node-keys;
        for @compute-node-keys -> $compute-node-key {
            my $zdlra               = ($compute-node-key.split(':'))[2];
            for $kv-server.SMEMBERS(:key('eb:zdlra:' ~ $zdlra ~ ':computenodes')).list -> $cn {
                %ZDLRAS{$zdlra}<COMPUTENODES>{$cn}<ALERTHISTORY> = Array.new;
                %ZDLRAS{$zdlra}<COMPUTENODES>{$cn}<PHYSICALDISK> = Array.new;
            }
        }
        my @storage-cell-keys       = $kv-server.KEYS(:key('eb:zdlra:*:storagecells'));
        die "No ZDLRA compute node keys!" unless @storage-cell-keys;
        for @storage-cell-keys -> $storage-cell-key {
            my $zdlra               = ($storage-cell-key.split(':'))[2];
            for $kv-server.SMEMBERS(:key('eb:zdlra:' ~ $zdlra ~ ':storagecells')).list -> $sc {
                %ZDLRAS{$zdlra}<STORAGECELLS>{$sc}<ALERTHISTORY> = Array.new;
                %ZDLRAS{$zdlra}<STORAGECELLS>{$sc}<PHYSICALDISK> = Array.new;
            }
        }
        $inventory-cache.store(:data(to-json(%ZDLRAS)));
    }
    else {
        %ZDLRAS                     = from-json($inventory-cache.fetch);
    }

    my %entity2zdlra;
    for %ZDLRAS.keys.sort -> $zdlra {
        my @batch = %ZDLRAS{$zdlra}<COMPUTENODES>.keys.sort;
        for @batch -> $cn {
            %entity2zdlra{$cn} = $zdlra;
        }
        @all-compute-nodes.append: @batch;

        @cellcli-gateways.push: @batch[0];

        @batch = %ZDLRAS{$zdlra}<STORAGECELLS>.keys.sort;
        @all-storage-cells.append: @batch;
        for @batch -> $sc {
            %entity2zdlra{$sc} = $zdlra;
        }
    }

    my $compute-nodes           = ZDLRA::ComputeNode::PhysicalDisk::Details.new(:compute-nodes(@all-compute-nodes));
    for $compute-nodes.Details.keys.sort -> $cn {
        my $zdlra               = %entity2zdlra{$cn};
        for $compute-nodes.Details{$cn} -> $rcds {
            for $rcds.list -> $rcd {
                %ZDLRAS{$zdlra}<COMPUTENODES>{$cn}<PHYSICALDISK>.push: $rcd;
            }
        }
    }

    my $storage-cells   = ZDLRA::StorageCell::PhysicalDisk::Details.new(:@cellcli-gateways);
    for $storage-cells.Details.keys.sort -> $sc {
        my $zdlra               = %entity2zdlra{$sc};
        for $storage-cells.Details{$sc} -> $rcds {
            for $rcds.list -> $rcd {
                %ZDLRAS{$zdlra}<STORAGECELLS>{$sc}<PHYSICALDISK>.push: $rcd;
            }
        }
    }

    for %ZDLRAS.keys -> $zdlra {
        put $zdlra;
        for %ZDLRAS{$zdlra}<COMPUTENODES>.keys.sort -> $cn {
            put ' ' x 4 ~ $cn;
            for %ZDLRAS{$zdlra}<COMPUTENODES>{$cn}<PHYSICALDISK>.list -> $pd {
                if $pd.status ne 'normal' {
                    printf "%20s%30s\n", $pd.name, $pd.status;
                }
            }
        }
        for %ZDLRAS{$zdlra}<STORAGECELLS>.keys.sort -> $sc {
            put ' ' x 4 ~ $sc;
            for %ZDLRAS{$zdlra}<STORAGECELLS>{$sc}<PHYSICALDISK>.list -> $pd {
                if $pd.status ne 'normal' {
                    printf "%20s%30s\n", $pd.name, $pd.status;
                }
            }
        }
    }
}
=finish

my %ah-dt-cache;
my %status;
my %command;

    my $identifier          = 'alerthistory_datetimes';
    my $ah-dt-cache         = Our::Cache.new(:$identifier);

    if ! $log-days && $ah-dt-cache.cache-hit {
        %ah-dt-cache        = from-json($ah-dt-cache.fetch) or note $?LINE;
        for %ah-dt-cache.keys.sort -> $dbm {
            for %ah-dt-cache{$dbm}.keys.sort -> $cell {
                %ah-dt-cache{$dbm}{$cell} = DateTime.new: %ah-dt-cache{$dbm}{$cell};
            }
        }
    }
    else {
        my $first-log       = now - (365 * 24 * 60 * 60);
        $first-log          = now - ($log-days * 24 * 60 * 60) if $log-days;
        my $first-dt        = DateTime.new(:timezone($*TZ), $first-log).truncated-to('second');
        for %inventory.keys.sort -> $dbm {
            for %inventory{$dbm}<CELLS>.keys.sort -> $cell {
                %ah-dt-cache{$dbm}{$cell} = $first-dt.clone;
            }
        }
        $ah-dt-cache.store(:data(to-json(%ah-dt-cache)));
    }

    %command                = ();
    for %inventory.keys -> $dbm {
        for %inventory{$dbm}<CELLS>.keys.sort -> $cell {
            %command{$cell} = (
                                'ssh',
                                $dbm,
                                'sudo',
                                'ssh',
                                $cell,
                                Q/"cellcli -e list alerthistory WHERE begintime \\> \\'/ ~ %ah-dt-cache{$dbm}{$cell}.Str ~ Q/\\'"/,
                            );
        }
    }

    my %alerthistory        = Async::Command::Multi.new(:%command).sow.reap;

    for %inventory.keys -> $dbm {
        for %inventory{$dbm}<CELLS>.keys.sort -> $cell {
            ALERTHISTORY-GRAMMAR.parse(%alerthistory{$cell}.stdout-results, :actions(ALERTHISTORY-ACTIONS.new(:$dbm, :$cell)));
        }
    }
    $ah-dt-cache.store(:data(to-json(%ah-dt-cache)));

    for %inventory.keys -> $dbm {
        put $dbm;
        for %inventory{$dbm}<CELLS>.keys.sort -> $cell {
            put "\t" ~ $cell;
            for %status{$dbm}<PHYSICALDISK>{$cell}.list -> $pd {
                printf "\t\t%s\t%s [%s]\n", $pd.status, $pd.name, $pd.serial if $pd.status ne 'normal';
            }
            if (%status{$dbm}<ALERTHISTORY>:exists) && (%status{$dbm}<ALERTHISTORY>{$cell}:exists) {
                for %status{$dbm}<ALERTHISTORY>{$cell}.list -> $logrcd {
                    printf "\t\t%s %s %s\n", $logrcd.datetime, $logrcd.severity, $logrcd.message;
                }
            }
        }
    }
}

=finish
